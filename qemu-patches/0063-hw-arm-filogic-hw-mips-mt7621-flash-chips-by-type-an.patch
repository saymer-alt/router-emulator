diff --git a/hw/arm/filogic/flash_chips.h b/hw/arm/filogic/flash_chips.h
new file mode 100644
index 0000000..e28d35b
--- /dev/null
+++ b/hw/arm/filogic/flash_chips.h
@@ -0,0 +1,135 @@
+/*
+ * Flash chips of the router machines: flash-type + flash-id name the chip,
+ * a listed chip has its size here, an ID that is not listed needs flash-mb.
+ * The type is never taken from the ID: an ID is just the bytes the chip
+ * answers with, and a user may set any.  The first chip of a type is the
+ * default one (no flash-id).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_FILOGIC_FLASH_CHIPS_H
+#define HW_FILOGIC_FLASH_CHIPS_H
+
+#include "qemu/error-report.h"
+
+typedef enum FlashChipType {
+    CHIP_NOR,                   /* SPI-NOR */
+    CHIP_NAND,                  /* SPI-NAND */
+    CHIP_PARALLEL_NAND,         /* MT7621 NFI */
+    CHIP_EMMC,
+} FlashChipType;
+
+static const char *const flash_chip_type_names[] = {
+    [CHIP_NOR] = "nor",
+    [CHIP_NAND] = "nand",
+    [CHIP_PARALLEL_NAND] = "parallel-nand",
+    [CHIP_EMMC] = "emmc",
+};
+
+static const struct FlashChip {
+    FlashChipType type;
+    const char *id;             /* READ ID / RDID bytes, hex, lower case */
+    uint32_t mb;
+} flash_chips[] = {
+    { CHIP_NOR, "ef4018", 16 },                 /* Winbond W25Q128JV */
+    { CHIP_NOR, "204018", 16 },                 /* XMC XM25QH128C/D */
+    { CHIP_NOR, "c84018", 16 },                 /* GigaDevice GD25Q128 */
+    { CHIP_NOR, "ef4019", 32 },                 /* Winbond W25Q256JV */
+    { CHIP_NOR, "ef4020", 64 },                 /* Winbond W25Q512JV */
+    { CHIP_NAND, "efaa21", 128 },               /* Winbond W25N01GV */
+    { CHIP_NAND, "c8017f7f7f", 128 },           /* ESMT F50L1G41LB */
+    { CHIP_NAND, "efaa22", 256 },               /* Winbond W25N02KV */
+    { CHIP_NAND, "efaa23", 512 },               /* Winbond W25N04KV */
+    { CHIP_PARALLEL_NAND, "ecf1009540", 128 },  /* Samsung K9F1G08U0D */
+    { CHIP_PARALLEL_NAND, "c2f18095", 128 },    /* Macronix MX30LF1G18AC */
+};
+
+/* "nor", "nand", "parallel-nand", "emmc" -> the type; -1: none of them */
+static inline int flash_chip_type(const char *s)
+{
+    for (int i = 0; i < ARRAY_SIZE(flash_chip_type_names); i++) {
+        if (!strcmp(s, flash_chip_type_names[i])) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* the listed chips of a type for option help: "ef4018 (16 MB), ..." */
+static inline char *flash_chip_list(FlashChipType type)
+{
+    GString *g = g_string_new(NULL);
+
+    for (int i = 0; i < ARRAY_SIZE(flash_chips); i++) {
+        if (flash_chips[i].type == type) {
+            g_string_append_printf(g, "%s%s (%u MB)", g->len ? ", " : "",
+                                   flash_chips[i].id, flash_chips[i].mb);
+        }
+    }
+    return g_string_free(g, false);
+}
+
+/*
+ * The chip of the options <opt>-id / <opt>-mb (opt "flash" or "flash2"):
+ * without an ID the default chip of the type, without a size the listed
+ * one.  Exits on an unlisted ID without a size and on a size that is not
+ * the listed chip's.
+ */
+static inline void flash_chip_resolve(const char *opt, FlashChipType type,
+                                      char **id, uint32_t *mb)
+{
+    const struct FlashChip *c = NULL;
+
+    if (*id) {
+        char *low = g_ascii_strdown(*id, -1);
+
+        g_free(*id);
+        *id = low;
+    }
+    for (int i = 0; i < ARRAY_SIZE(flash_chips); i++) {
+        if (flash_chips[i].type == type &&
+            (!*id || !strcmp(*id, flash_chips[i].id))) {
+            c = &flash_chips[i];
+            break;
+        }
+    }
+    if (!*id) {
+        *id = g_strdup(c->id);
+    }
+    if (c && *mb && *mb != c->mb) {
+        error_report("%s-mb=%u: %s-id=%s is a %u MB %s chip", opt, *mb, opt,
+                     *id, c->mb, flash_chip_type_names[type]);
+        exit(1);
+    }
+    if (c) {
+        *mb = c->mb;
+    } else if (!*mb) {
+        error_report("%s-id=%s is not a known %s chip: give its size, "
+                     "%s-mb=MB", opt, *id, flash_chip_type_names[type], opt);
+        exit(1);
+    }
+}
+
+/*
+ * A SPI-NOR unique ID (command 4b) given as Cudy firmware shows it in
+ * /proc/sys/dev/flash_uuid: its kernel prints the bytes last first, the
+ * chip sends them in its own order.  Returns the "uid" of the SPI-NOR.
+ */
+static inline char *flash_chip_nor_uid(const char *shown)
+{
+    size_t n = strlen(shown);
+    char *uid = g_malloc0(n + 1);
+
+    if (n % 2) {
+        memcpy(uid, shown, n);
+        return uid;
+    }
+    for (size_t i = 0; i + 1 < n; i += 2) {
+        uid[n - i - 2] = shown[i];
+        uid[n - i - 1] = shown[i + 1];
+    }
+    return uid;
+}
+
+#endif
