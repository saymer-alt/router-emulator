+        exit(1);
+    }
+    flash_chip_resolve("flash", type, &b->flash_id, &b->flash_mb);
+    b->flash_nand = type == CHIP_PARALLEL_NAND;
+    if (b->flash_nand) {
+        if (b->flash_uid) {
+            error_report("flash-uid: the parallel NAND has no unique ID");
+            exit(1);
+        }
+        b->nand_id = b->flash_id;
+        b->nand_mb = b->flash_mb;
+    } else {
+        b->nor_id = b->flash_id;
+        b->nor_mb = b->flash_mb;
+        b->nor_uid = b->flash_uid;
+    }
+}
