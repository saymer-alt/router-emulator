+    if ((!b->flash_nor || b->nor_nand) && !b->flash_emmc &&
+        b->nand_mb != 128 && b->nand_mb != 256 && b->nand_mb != 512) {
+        error_report("a SPI-NAND has 128, 256 or 512 MB (flash-mb)");
         exit(1);
