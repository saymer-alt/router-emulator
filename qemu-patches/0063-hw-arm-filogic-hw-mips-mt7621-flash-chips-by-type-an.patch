+/* the boot flash: flash-type (default nor) with flash-id / flash-mb / flash-uid */
+static void mt7621_flash_config(MT7621Board *b)
+{
+    int type = b->flash_type ? flash_chip_type(b->flash_type) : CHIP_NOR;
+
+    if (type != CHIP_NOR && type != CHIP_PARALLEL_NAND) {
