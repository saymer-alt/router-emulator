+/*
+ * The flash chips: flash-type (default nand) with flash-id / flash-mb /
+ * flash-uid, and with any flash2-* option the second chip of SPI-NOR +
+ * SPI-NAND boards, of the other type
+ */
+static void router_flash_config(RouterState *b)
+{
+    int type = b->flash_type ? flash_chip_type(b->flash_type) : CHIP_NAND;
+
+    if (type != CHIP_NOR && type != CHIP_NAND && type != CHIP_EMMC) {
+        error_report("flash-type must be nand, nor or emmc");
+        exit(1);
+    }
+    if (type == CHIP_EMMC) {
+        if (b->flash_id || b->flash_mb || b->flash_uid ||
+            b->flash2_id || b->flash2_mb || b->flash2_uid) {
+            error_report("flash-type=emmc takes no flash-* / flash2-* options");
+            exit(1);
+        }
+        b->flash_emmc = true;
+        return;
+    }
+    b->flash_nor = type == CHIP_NOR;
+    b->nor_nand = b->flash2_id || b->flash2_mb || b->flash2_uid;
+    for (int second = 0; second <= b->nor_nand; second++) {
+        bool nor = b->flash_nor != second;
+        char **id = second ? &b->flash2_id : &b->flash_id;
+        uint32_t *mb = second ? &b->flash2_mb : &b->flash_mb;
+        char *uid = second ? b->flash2_uid : b->flash_uid;
+
+        flash_chip_resolve(second ? "flash2" : "flash",
+                           nor ? CHIP_NOR : CHIP_NAND, id, mb);
+        if (nor) {
+            b->nor_id = *id;
+            b->nor_mb = *mb;
+            b->nor_uid = uid;
+        } else {
+            b->nand_id = *id;
+            b->nand_mb = *mb;
+            b->nand_uid = uid;
+        }
+    }
+}
