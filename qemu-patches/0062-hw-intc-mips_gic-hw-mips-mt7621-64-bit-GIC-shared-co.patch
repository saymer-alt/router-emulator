From b16e4b529b09359651cd8013993a6dbcd3a916a4 Mon Sep 17 00:00:00 2001
From: Dmitry Mostovoy <stavultras@gmail.com>
Date: Sun, 25 Oct 2026 07:41:54 -0400
Subject: [PATCH] hw/intc/mips_gic, hw/mips/mt7621: 64-bit GIC shared counter

The GIC shared counter was 32 bits wide (COUNTERHI read 0, COUNTBITS 0),
while Linux registers it as a 64-bit sched_clock on the MT7621: the
timestamps wrapped every 4.88 s at 880 MHz (4.x -> 8795.x -> 0.x).
Opt-in property counter64: COUNTERHI and 64-bit COUNTERLO reads give
the upper half, COUNTBITS says 64 bits; MT7621 sets it, as the chip has.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012GbUcwR34gg9RgGTEtNN6J
---
 hw/intc/mips_gic.c               | 28 ++++++++++++++++++++++------
 hw/mips/mt7621.c                 |  1 +
 hw/timer/mips_gictimer.c         | 20 ++++++++++----------
 include/hw/intc/mips_gic.h       |  1 +
 include/hw/timer/mips_gictimer.h |  4 ++--
 5 files changed, 36 insertions(+), 18 deletions(-)

diff --git a/hw/intc/mips_gic.c b/hw/intc/mips_gic.c
index 7681b09..5ec7b5f 100644
--- a/hw/intc/mips_gic.c
+++ b/hw/intc/mips_gic.c
@@ -139,9 +139,13 @@ static uint64_t gic_read(void *opaque, hwaddr addr, unsigned size)
         break;
     case GIC_SH_COUNTERLO_OFS:
         ret = mips_gictimer_get_sh_count(gic->gic_timer);
+        if (!gic->counter64 || size < 8) {
+            ret = (uint32_t)ret;    /* a 64-bit access reads both halves */
+        }
         break;
     case GIC_SH_COUNTERHI_OFS:
-        ret = 0;
+        ret = gic->counter64 ?
+              mips_gictimer_get_sh_count(gic->gic_timer) >> 32 : 0;
         break;
     case GIC_SH_PEND_OFS ... GIC_SH_PEND_LAST_OFS:
         /* each bit represents pending status for an interrupt pin */
@@ -186,10 +190,11 @@ static uint64_t gic_read(void *opaque, hwaddr addr, unsigned size)
         break;
     /* User-Mode Visible section */
     case USM_VISIBLE_SECTION_OFS + GIC_USER_MODE_COUNTERLO:
-        ret = mips_gictimer_get_sh_count(gic->gic_timer);
+        ret = (uint32_t)mips_gictimer_get_sh_count(gic->gic_timer);
         break;
     case USM_VISIBLE_SECTION_OFS + GIC_USER_MODE_COUNTERHI:
-        ret = 0;
+        ret = gic->counter64 ?
+              mips_gictimer_get_sh_count(gic->gic_timer) >> 32 : 0;
         break;
     default:
         qemu_log_mask(LOG_UNIMP, "Read %d bytes at GIC offset 0x%" PRIx64 "\n",
@@ -334,7 +339,18 @@ static void gic_write(void *opaque, hwaddr addr, uint64_t data, unsigned size)
         break;
     case GIC_SH_COUNTERLO_OFS:
         if (mips_gictimer_get_countstop(gic->gic_timer)) {
-            mips_gictimer_store_sh_count(gic->gic_timer, data);
+            uint64_t cnt = mips_gictimer_get_sh_count(gic->gic_timer);
+
+            mips_gictimer_store_sh_count(gic->gic_timer,
+                                         deposit64(cnt, 0, 32, data));
+        }
+        break;
+    case GIC_SH_COUNTERHI_OFS:
+        if (gic->counter64 && mips_gictimer_get_countstop(gic->gic_timer)) {
+            uint64_t cnt = mips_gictimer_get_sh_count(gic->gic_timer);
+
+            mips_gictimer_store_sh_count(gic->gic_timer,
+                                         deposit64(cnt, 32, 32, data));
         }
         break;
     case GIC_SH_RMASK_OFS ... GIC_SH_RMASK_LAST_OFS:
@@ -410,8 +426,8 @@ static void gic_reset(void *opaque)
     int numintrs = (gic->num_irq / 8) - 1;
 
     gic->sh_config = /* COUNTSTOP = 0 it is accessible via MIPSGICTimer*/
-                     /* CounterHi not implemented */
-                     (0            << GIC_SH_CONFIG_COUNTBITS_SHF) |
+                     /* COUNTBITS: 32 + 4 * n bits */
+                     ((gic->counter64 ? 8 : 0) << GIC_SH_CONFIG_COUNTBITS_SHF) |
                      (numintrs     << GIC_SH_CONFIG_NUMINTRS_SHF)  |
                      (gic->num_vps << GIC_SH_CONFIG_PVPS_SHF);
     for (i = 0; i < gic->num_vps; i++) {
diff --git a/hw/mips/mt7621.c b/hw/mips/mt7621.c
index 42c1090..9cd753c 100644
--- a/hw/mips/mt7621.c
+++ b/hw/mips/mt7621.c
@@ -1193,6 +1193,7 @@ static void mt7621_init(MachineState *machine)
     sysbus_mmio_map_overlap(SYS_BUS_DEVICE(&b->cps), 0, 0, 1);
     /* the GIC counter runs at the CPU clock (Linux: clocks = CPU) */
     mips_gictimer_set_freq(b->cps.gic.gic_timer, MT7621_CPU_HZ);
+    b->cps.gic.counter64 = true;   /* Linux: sched_clock of 64 bits */
 
     CPU_FOREACH(cs) {
         cpu_env(cs)->cache_hook = mt7621_cache_hook;
diff --git a/hw/timer/mips_gictimer.c b/hw/timer/mips_gictimer.c
index 2206aa1..0462e0c 100644
--- a/hw/timer/mips_gictimer.c
+++ b/hw/timer/mips_gictimer.c
@@ -23,7 +23,7 @@ void mips_gictimer_set_freq(MIPSGICTimerState *gic, uint32_t hz)
     gic->freq = hz;
 }
 
-static uint32_t gic_ticks(MIPSGICTimerState *gic, uint64_t ns)
+static uint64_t gic_ticks(MIPSGICTimerState *gic, uint64_t ns)
 {
     return muldiv64(ns, gic->freq, NANOSECONDS_PER_SECOND);
 }
@@ -34,8 +34,8 @@ static void gic_vptimer_update(MIPSGICTimerState *gictimer,
     uint64_t next;
     uint32_t wait;
 
-    wait = gictimer->vptimers[vp_index].comparelo - gictimer->sh_counterlo -
-           gic_ticks(gictimer, now);
+    wait = gictimer->vptimers[vp_index].comparelo -
+           (uint32_t)(gictimer->sh_counter + gic_ticks(gictimer, now));
     next = now + muldiv64(wait, NANOSECONDS_PER_SECOND, gictimer->freq);
 
     timer_mod(gictimer->vptimers[vp_index].qtimer, next);
@@ -60,11 +60,11 @@ static void gic_vptimer_cb(void *opaque)
                        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
 }
 
-uint32_t mips_gictimer_get_sh_count(MIPSGICTimerState *gictimer)
+uint64_t mips_gictimer_get_sh_count(MIPSGICTimerState *gictimer)
 {
     int i;
     if (gictimer->countstop) {
-        return gictimer->sh_counterlo;
+        return gictimer->sh_counter;
     } else {
         uint64_t now;
         now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
@@ -75,7 +75,7 @@ uint32_t mips_gictimer_get_sh_count(MIPSGICTimerState *gictimer)
                 gic_vptimer_expire(gictimer, i, now);
             }
         }
-        return gictimer->sh_counterlo + gic_ticks(gictimer, now);
+        return gictimer->sh_counter + gic_ticks(gictimer, now);
     }
 }
 
@@ -85,11 +85,11 @@ void mips_gictimer_store_sh_count(MIPSGICTimerState *gictimer, uint64_t count)
     uint64_t now;
 
     if (gictimer->countstop || !gictimer->vptimers[0].qtimer) {
-        gictimer->sh_counterlo = count;
+        gictimer->sh_counter = count;
     } else {
         /* Store new count register */
         now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
-        gictimer->sh_counterlo = count - gic_ticks(gictimer, now);
+        gictimer->sh_counter = count - gic_ticks(gictimer, now);
         /* Update timer timer */
         for (i = 0; i < gictimer->num_vps; i++) {
             gic_vptimer_update(gictimer, i, now);
@@ -119,7 +119,7 @@ uint8_t mips_gictimer_get_countstop(MIPSGICTimerState *gictimer)
 void mips_gictimer_start_count(MIPSGICTimerState *gictimer)
 {
     gictimer->countstop = 0;
-    mips_gictimer_store_sh_count(gictimer, gictimer->sh_counterlo);
+    mips_gictimer_store_sh_count(gictimer, gictimer->sh_counter);
 }
 
 void mips_gictimer_stop_count(MIPSGICTimerState *gictimer)
@@ -128,7 +128,7 @@ void mips_gictimer_stop_count(MIPSGICTimerState *gictimer)
 
     gictimer->countstop = 1;
     /* Store the current value */
-    gictimer->sh_counterlo +=
+    gictimer->sh_counter +=
         gic_ticks(gictimer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
     for (i = 0; i < gictimer->num_vps; i++) {
         timer_del(gictimer->vptimers[i].qtimer);
diff --git a/include/hw/intc/mips_gic.h b/include/hw/intc/mips_gic.h
index 31db277..b318b53 100644
--- a/include/hw/intc/mips_gic.h
+++ b/include/hw/intc/mips_gic.h
@@ -219,6 +219,7 @@ struct MIPSGICState {
      * Vx_CTL TIMER_ROUTABLE, Vx_TIMER_MAP) instead of their IP[IPTI]
      */
     uint32_t timer_routable;
+    bool counter64;             /* 64-bit shared counter (COUNTERHI) */
 };
 
 #endif /* MIPS_GIC_H */
diff --git a/include/hw/timer/mips_gictimer.h b/include/hw/timer/mips_gictimer.h
index 32a9e18..520a86f 100644
--- a/include/hw/timer/mips_gictimer.h
+++ b/include/hw/timer/mips_gictimer.h
@@ -26,7 +26,7 @@ struct MIPSGICTimerState {
     void *opaque;
     uint8_t countstop;
     uint32_t freq;              /* counter frequency, Hz */
-    uint32_t sh_counterlo;
+    uint64_t sh_counter;        /* 64 bits; GICs with a 32-bit one show the low half */
     int32_t num_vps;
     MIPSGICTimerVPState *vptimers;
     MIPSGICTimerCB *cb;
@@ -34,7 +34,7 @@ struct MIPSGICTimerState {
 
 uint32_t mips_gictimer_get_freq(MIPSGICTimerState *gic);
 void mips_gictimer_set_freq(MIPSGICTimerState *gic, uint32_t hz);
-uint32_t mips_gictimer_get_sh_count(MIPSGICTimerState *gic);
+uint64_t mips_gictimer_get_sh_count(MIPSGICTimerState *gic);
 void mips_gictimer_store_sh_count(MIPSGICTimerState *gic, uint64_t count);
 uint32_t mips_gictimer_get_vp_compare(MIPSGICTimerState *gictimer,
                                       uint32_t vp_index);
-- 
2.47.3

