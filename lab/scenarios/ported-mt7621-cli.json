{
  "name": "KeeneticOS Ported MT7621: ndm CLI over telnet on 127.0.0.1 only (Xiaomi Mi Router 3G, Breed)",
  "evidence": "KEENETICOS_VIRTUAL",
  "steps": [
    {
      "action": "wait_serial",
      "pattern": "Boot and Recovery Environment",
      "timeout_sec": 90
    },
    {
      "action": "wait_serial",
      "pattern": "Starting kernel",
      "timeout_sec": 240
    },
    {
      "action": "wait_serial",
      "pattern": "Linux version",
      "timeout_sec": 100
    },
    {
      "action": "wait_serial",
      "pattern": "Brought up 4 CPUs",
      "timeout_sec": 240
    },
    {
      "action": "wait_serial",
      "pattern": "system ready",
      "timeout_sec": 600
    },
    {
      "action": "wait_serial",
      "pattern": "waiting for connections",
      "timeout_sec": 120
    },
    {
      "action": "telnet",
      "port": 8023,
      "greeting": "\\(config\\)>",
      "timeout_sec": 60
    },
    {
      "action": "telnet",
      "port": 8023,
      "send": "show version",
      "expect": "release: 5\\.01\\.C\\.8\\.0-2",
      "timeout_sec": 60,
      "greeting": "\\(config\\)>"
    },
    {
      "action": "telnet",
      "port": 8023,
      "send": "show system",
      "expect": "hostname: ",
      "timeout_sec": 60,
      "greeting": "\\(config\\)>"
    }
  ]
}
